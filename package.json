{
  "name": "ai-valley",
  "version": "2.2.0",
  "private": true,
  "description": "An observation-only AI settlement simulation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server/godot-web-main.ts",
    "dev:web": "node --import tsx src/server/godot-web-main.ts",
    "build": "tsc --noEmit && node scripts/clean-build.mjs && tsc -p tsconfig.server.json",
    "start": "node build/server/godot-web-main.js",
    "test": "node scripts/test.mjs",
    "check": "tsc --noEmit",
    "test:godot": "node scripts/test-godot-headless.mjs",
    "build:godot:web": "node scripts/export-godot-web.mjs",
    "demo:godot:web": "node --import tsx src/server/godot-web-main.ts",
    "dev:web:persistent": "node --import tsx src/server/godot-mvp-persistent-main.ts",
    "start:web:persistent": "node build/server/godot-mvp-persistent-main.js"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
