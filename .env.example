# Load explicitly with node --env-file=.env build/server/main.js.
PORT=3412
VALLEY_DB=runtime/formal.sqlite
VALLEY_DAY_MINUTES=20

# Leave both blank for a read-only preview of the starting world.
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=

# Optional alternatives to the environment keys.
# VALLEY_DASHSCOPE_KEY_FILE=/path/to/dashscope.key
# VALLEY_KEY_FILE=/path/to/siliconflow.json
