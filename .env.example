# Build TypeScript and Godot Web first, then explicitly load this file:
# node --env-file=.env build/server/godot-mvp-persistent-main.js
VALLEY_DAY_MINUTES=20

# Keys alone never enable execution. Default npm run dev and npm start are rules-only demos.
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=

# Credential files are not read automatically.

# Opt-in USER-OPERATED persistent browser service only:
VALLEY_SELF_HOSTED=disabled
VALLEY_PRIMARY_PROVIDER=siliconflow
VALLEY_PRIMARY_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
# Optional fallback: set BOTH provider and model, or leave BOTH blank.
# Providers: siliconflow (CN), dashscope (Qwen, requires paid opt-in).
VALLEY_BACKUP_PROVIDER=
VALLEY_BACKUP_MODEL=
# Supported: DeepSeek above, THUDM/GLM-Z1-9B-0414, qwen3.8-flash.
# Verify CURRENT provider price/qualification yourself. Names do not prove free.
# qwen3.8-flash requires DASHSCOPE_API_KEY and explicit paid opt-in:
VALLEY_ALLOW_PAID_MODELS=no

# Godot MVP persistent entry (Linux local filesystem only; separate small save):
# node --env-file=.env --import tsx src/server/godot-mvp-persistent-main.ts
# Uses the SAME explicit PRIMARY/BACKUP provider/model configuration above.
# VALLEY_SELF_HOSTED=disabled still means paused, no model and no rule fallback.
VALLEY_MVP_PORT=3415
VALLEY_MVP_DB=runtime/godot-mvp/world.sqlite
# Legacy PORT / VALLEY_DB variables do not configure this MVP entry.
