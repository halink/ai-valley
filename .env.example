# Load explicitly with node --env-file=.env build/server/main.js.
PORT=3412
VALLEY_DB=runtime/formal.sqlite
VALLEY_DAY_MINUTES=20

# Keys alone never enable execution. The default main.js remains model-disabled.
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=

# Credential files are not read by either startup entry.

# Opt-in USER-OPERATED entry only (formal main remains model-disabled):
# node --env-file=.env build/server/self-hosted-main.js
VALLEY_SELF_HOSTED=disabled
VALLEY_PRIMARY_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
# Optional explicit fallback; never inferred from the presence of another key.
VALLEY_BACKUP_MODEL=
# Supported: DeepSeek above, THUDM/GLM-Z1-9B-0414, qwen3.8-flash.
# Verify CURRENT provider price/qualification yourself. Names do not prove free.
# qwen3.8-flash requires DASHSCOPE_API_KEY and explicit paid opt-in:
VALLEY_ALLOW_PAID_MODELS=no
